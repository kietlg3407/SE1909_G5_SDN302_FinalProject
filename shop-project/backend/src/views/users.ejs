<%- include('partials/header') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
  <div>
    <h3 class="fw-bold mb-1">Quản lý Người dùng</h3>
    <p class="text-muted mb-0 small">Hỗ trợ Tìm kiếm (Search), Lọc vai trò (Filter) và Phân trang (Pagination)</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <span class="badge bg-secondary-subtle text-secondary px-3 py-2">
      Tổng số: <strong><%= pagination.totalUsers %></strong> tài khoản
    </span>
  </div>
</div>

<!-- Notice / Error Alerts -->
<% if (notice) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i><%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Search & Filter Card -->
<div class="card p-3 mb-4">
  <form action="/admin/users" method="GET" class="row g-2 align-items-center">
    <div class="col-12 col-md-5">
      <div class="input-group">
        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
        <input 
          type="text" 
          name="search" 
          class="form-control" 
          placeholder="Tìm theo họ tên hoặc email..." 
          value="<%= filter.search %>"
        >
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-3">
      <select name="role" class="form-select">
        <option value="all" <%= filter.role === 'all' ? 'selected' : '' %>>Tất cả vai trò</option>
        <option value="customer" <%= filter.role === 'customer' ? 'selected' : '' %>>Khách hàng (Customer)</option>
        <option value="staff" <%= filter.role === 'staff' ? 'selected' : '' %>>Nhân viên (Staff)</option>
        <option value="admin" <%= filter.role === 'admin' ? 'selected' : '' %>>Quản trị viên (Admin)</option>
      </select>
    </div>

    <div class="col-12 col-sm-6 col-md-4 d-flex gap-2">
      <button type="submit" class="btn btn-primary d-flex align-items-center gap-1">
        <i class="bi bi-funnel-fill"></i> Lọc dữ liệu
      </button>
      <a href="/admin/users" class="btn btn-outline-secondary">Đặt lại</a>
    </div>
  </form>
</div>

<!-- Users Table Card -->
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Người dùng</th>
          <th>Email</th>
          <th>Vai trò hiện tại</th>
          <th>Địa chỉ nhận hàng</th>
          <th>Ngày tạo</th>
          <th class="text-end">Hành động (Action)</th>
        </tr>
      </thead>
      <tbody>
        <% if (users && users.length > 0) { %>
          <% users.forEach(u => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary border fw-bold" style="width: 38px; height: 38px;">
                    <%= u.name ? u.name.charAt(0).toUpperCase() : '?' %>
                  </div>
                  <div>
                    <div class="fw-semibold"><%= u.name %></div>
                    <div class="text-muted small">ID: <code class="text-secondary"><%= u._id.toString().slice(-6) %></code></div>
                  </div>
                </div>
              </td>
              <td><%= u.email %></td>
              <td>
                <span class="badge badge-role-<%= u.role %> px-2 py-1 text-capitalize"><%= u.role %></span>
              </td>
              <td>
                <% if (u.role === 'customer') { %>
                  <% if (u.addresses && u.addresses.length > 0) { %>
                    <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#addressModal-<%= u._id %>">
                      <i class="bi bi-geo-alt-fill me-1"></i><%= u.addresses.length %> địa chỉ
                    </button>

                    <!-- Address Modal -->
                    <div class="modal fade" id="addressModal-<%= u._id %>" tabindex="-1">
                      <div class="modal-dialog">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h6 class="modal-title fw-bold">Sổ địa chỉ của <%= u.name %></h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <% u.addresses.forEach((addr, idx) => { %>
                              <div class="p-2 mb-2 border rounded <%= addr.isDefault ? 'border-primary bg-primary-subtle bg-opacity-10' : 'bg-light' %>">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                  <span class="fw-semibold small">Địa chỉ #<%= idx + 1 %></span>
                                  <% if (addr.isDefault) { %>
                                    <span class="badge bg-primary">Mặc định</span>
                                  <% } %>
                                </div>
                                <div class="small text-muted"><i class="bi bi-telephone me-1"></i><%= addr.phone %></div>
                                <div class="small"><i class="bi bi-house me-1"></i><%= addr.street %>, <%= addr.city %>, <%= addr.state %></div>
                              </div>
                            <% }) %>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% } else { %>
                    <span class="text-muted small">Chưa có</span>
                  <% } %>
                <% } else { %>
                  <span class="badge bg-light text-secondary border">Không áp dụng (Nội bộ)</span>
                <% } %>
              </td>
              <td class="text-muted small">
                <%= new Date(u.createdAt).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
              </td>
              <td class="text-end">
                <div class="d-inline-flex align-items-center gap-1">
                  <!-- Change Role Form -->
                  <form action="/admin/users/<%= u._id %>/role" method="POST" class="d-inline-flex align-items-center gap-1">
                    <select name="role" class="form-select form-select-sm" style="width: auto;" <%= u._id.toString() === currentUser._id.toString() ? 'disabled' : '' %>>
                      <option value="customer" <%= u.role === 'customer' ? 'selected' : '' %>>Customer</option>
                      <option value="staff" <%= u.role === 'staff' ? 'selected' : '' %>>Staff</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                    <% if (u._id.toString() !== currentUser._id.toString()) { %>
                      <button type="submit" class="btn btn-sm btn-outline-primary" title="Cập nhật vai trò">
                        <i class="bi bi-check-lg"></i>
                      </button>
                    <% } %>
                  </form>

                  <!-- Delete User Form with Confirmation Modal -->
                  <% if (u._id.toString() !== currentUser._id.toString()) { %>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-<%= u._id %>" title="Xóa tài khoản">
                      <i class="bi bi-trash"></i>
                    </button>

                    <!-- Delete Modal -->
                    <div class="modal fade" id="deleteModal-<%= u._id %>" tabindex="-1">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h6 class="modal-title text-danger fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa tài khoản</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body text-start">
                            Bạn có chắc chắn muốn xóa tài khoản <strong><%= u.name %></strong> (<code><%= u.email %></code>)?
                            <div class="alert alert-warning mt-2 mb-0 small">Hành động này không thể hoàn tác.</div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy</button>
                            <form action="/admin/users/<%= u._id %>/delete" method="POST">
                              <button type="submit" class="btn btn-sm btn-danger">Xác nhận xóa</button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary small">Bạn</span>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="bi bi-people fs-1 d-block text-secondary mb-2"></i>
              Không tìm thấy người dùng nào phù hợp với bộ lọc
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Controls -->
  <% if (pagination.totalPages > 1) { %>
    <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3">
      <div class="small text-muted">
        Trang <%= pagination.currentPage %> / <%= pagination.totalPages %> (Hiển thị tối đa <%= pagination.limit %> mục/trang)
      </div>

      <nav aria-label="Users pagination">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/admin/users?page=<%= pagination.currentPage - 1 %>&search=<%= encodeURIComponent(filter.search) %>&role=<%= filter.role %>">
              <i class="bi bi-chevron-left"></i> Trước
            </a>
          </li>

          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
              <a class="page-link" href="/admin/users?page=<%= p %>&search=<%= encodeURIComponent(filter.search) %>&role=<%= filter.role %>">
                <%= p %>
              </a>
            </li>
          <% } %>

          <li class="page-item <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/admin/users?page=<%= pagination.currentPage + 1 %>&search=<%= encodeURIComponent(filter.search) %>&role=<%= filter.role %>">
              Sau <i class="bi bi-chevron-right"></i>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
