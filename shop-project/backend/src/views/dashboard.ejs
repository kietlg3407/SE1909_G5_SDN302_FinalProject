<%- include('partials/header') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h3 class="fw-bold mb-1">Bảng điều khiển Tổng quan</h3>
    <p class="text-muted mb-0 small">Thống kê hoạt động hệ thống quản trị (Server-Side Rendered bằng EJS)</p>
  </div>
  <a href="/admin/users" class="btn btn-primary d-flex align-items-center gap-2">
    <i class="bi bi-people-fill"></i>
    <span>Quản lý người dùng</span>
  </a>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-muted small fw-medium">Tổng người dùng</span>
          <h2 class="fw-bold mt-2 mb-0 text-primary"><%= stats.totalUsers %></h2>
        </div>
        <div class="p-3 bg-primary-subtle text-primary rounded-3">
          <i class="bi bi-people-fill fs-4"></i>
        </div>
      </div>
      <div class="mt-3 small text-muted">Bao gồm khách hàng, nhân viên & admin</div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-muted small fw-medium">Khách hàng (Customer)</span>
          <h2 class="fw-bold mt-2 mb-0 text-success"><%= stats.totalCustomers %></h2>
        </div>
        <div class="p-3 bg-success-subtle text-success rounded-3">
          <i class="bi bi-person-check-fill fs-4"></i>
        </div>
      </div>
      <div class="mt-3 small text-muted">Tài khoản mua sắm trực tuyến</div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-muted small fw-medium">Quản trị viên (Admin)</span>
          <h2 class="fw-bold mt-2 mb-0 text-danger"><%= stats.totalAdmins %></h2>
        </div>
        <div class="p-3 bg-danger-subtle text-danger rounded-3">
          <i class="bi bi-shield-fill-check fs-4"></i>
        </div>
      </div>
      <div class="mt-3 small text-muted">Có toàn quyền hệ thống</div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card p-3">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <span class="text-muted small fw-medium">Mã giảm giá (Coupons)</span>
          <h2 class="fw-bold mt-2 mb-0 text-warning"><%= stats.totalCoupons %></h2>
        </div>
        <div class="p-3 bg-warning-subtle text-warning rounded-3">
          <i class="bi bi-ticket-perforated-fill fs-4"></i>
        </div>
      </div>
      <div class="mt-3 small text-muted">Đang quản lý trên hệ thống</div>
    </div>
  </div>
</div>

<!-- Recent Users List -->
<div class="card">
  <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
    <h5 class="mb-0 fw-bold">Người dùng mới đăng ký gần đây</h5>
    <a href="/admin/users" class="btn btn-outline-primary btn-sm">Xem tất cả</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Người dùng</th>
          <th>Email</th>
          <th>Vai trò</th>
          <th>Số địa chỉ</th>
          <th>Ngày tạo</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentUsers && recentUsers.length > 0) { %>
          <% recentUsers.forEach(u => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary border fw-bold" style="width: 36px; height: 36px;">
                    <%= u.name ? u.name.charAt(0).toUpperCase() : '?' %>
                  </div>
                  <span class="fw-medium"><%= u.name %></span>
                </div>
              </td>
              <td><%= u.email %></td>
              <td>
                <span class="badge badge-role-<%= u.role %> px-2 py-1 text-capitalize"><%= u.role %></span>
              </td>
              <td>
                <span class="badge bg-secondary-subtle text-secondary"><%= u.addresses ? u.addresses.length : 0 %> địa chỉ</span>
              </td>
              <td class="text-muted small">
                <%= new Date(u.createdAt).toLocaleDateString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' }) %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-4 text-muted">Chưa có người dùng nào</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
