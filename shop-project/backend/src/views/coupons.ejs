<%- include('partials/header') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h3 class="fw-bold mb-1">Quản lý Mã giảm giá (Coupons)</h3>
    <p class="text-muted mb-0 small">Hiển thị danh sách Voucher & Mã giảm giá (Dữ liệu liên kết Mongoose Population với User)</p>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Mã Voucher</th>
          <th>Loại giảm giá</th>
          <th>Giá trị</th>
          <th>Đơn hàng tối thiểu</th>
          <th>Hạn sử dụng</th>
          <th>Người tạo (Populated)</th>
        </tr>
      </thead>
      <tbody>
        <% if (coupons && coupons.length > 0) { %>
          <% coupons.forEach(c => { %>
            <tr>
              <td>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 font-monospace px-2 py-1">
                  <%= c.code %>
                </span>
              </td>
              <td>
                <span class="text-capitalize"><%= c.discountType === 'percentage' ? 'Phần trăm (%)' : 'Số tiền cố định (VNĐ)' %></span>
              </td>
              <td class="fw-bold text-success">
                <%= c.discountType === 'percentage' ? c.discountValue + '%' : c.discountValue.toLocaleString() + ' đ' %>
              </td>
              <td>
                <%= c.minOrderValue ? c.minOrderValue.toLocaleString() + ' đ' : '0 đ' %>
              </td>
              <td class="small text-muted">
                <%= c.expiryDate ? new Date(c.expiryDate).toLocaleDateString('vi-VN') : 'Vô thời hạn' %>
              </td>
              <td>
                <% if (c.createdBy) { %>
                  <div class="d-flex align-items-center gap-1">
                    <i class="bi bi-person-circle text-primary"></i>
                    <span class="small fw-semibold"><%= c.createdBy.name || c.createdBy.email %></span>
                  </div>
                <% } else { %>
                  <span class="badge bg-light text-secondary border">Hệ thống (System)</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center py-4 text-muted">Chưa có mã giảm giá nào</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
