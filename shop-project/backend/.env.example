# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# SDN302 Final Project - E-Commerce Admin System
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env (Linux/macOS) OR copy .env.example .env (Windows)
# 2. Fill in the actual credentials for your environment.
# 3. NEVER commit the actual '.env' file into version control (git).
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Accepts either MONGO_URI or MONGODB_URI (compatible with MongoDB Atlas, Render, Railway, AWS, Docker)
# Local development example: mongodb://127.0.0.1:27017/shop-project
# Production Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/shop-project
MONGODB_URI=mongodb://127.0.0.1:27017/shop-project
MONGO_TEST_URI=mongodb://127.0.0.1:27017/shop_test

# JSON Web Token (JWT) Authentication
# CRITICAL SECURITY NOTE:
# - Must be a high-entropy, random cryptographic secret (min 32 characters in production)
# - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - NEVER share or expose this key
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_random
JWT_EXPIRES_IN=30d

# Cloudinary Storage Configuration (Product & Avatar Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Client URL
# Used in the password-reset email link: {CLIENT_URL}/reset-password/{token}
CLIENT_URL=http://localhost:5173

# Password reset email (Nodemailer / Gmail SMTP, smtp.gmail.com:465)
# EMAIL_PASS must be a Gmail App Password (16 characters), not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords
# NEVER commit the real .env file or a real app password.
EMAIL_USER=baolgce191178@gmail.com
EMAIL_PASS=your_gmail_app_password_16_chars
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
# Optional. Defaults to EMAIL_USER when SMTP is configured.
EMAIL_FROM=
