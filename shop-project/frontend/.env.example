# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# SDN302 Final Project - E-Commerce Client & Admin Web Application
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' or '.env.local':
#      cp .env.example .env (Linux/macOS) OR copy .env.example .env (Windows)
# 2. Adjust the API URL according to your backend server deployment.
# 3. DO NOT commit private credentials or production secret URLs to git.
# ==============================================================================

# Backend API Origin
# Supported variables (in order of priority):
# - VITE_API_BASE_URL: Main API root (e.g. http://localhost:5000 or https://api.yourdomain.com)
# - VITE_API_URL: Alternative / legacy key (e.g. http://localhost:5000 or http://localhost:5000/api)
# Note: Endpoint calls across the app include '/api/...', so base URL should typically point to origin.
VITE_API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# Application Environment (development | production | test)
NODE_ENV=development
